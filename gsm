bool isNumberAllowed(String incoming) {
  int q1 = incoming.indexOf('"');
  int q2 = incoming.indexOf('"', q1 + 1);
  if (q1 < 0 || q2 < 0) return false;

  String raw = incoming.substring(q1 + 1, q2);
  String clean = "";
  for (unsigned int i = 0; i < raw.length(); i++) {
    if (isDigit(raw.charAt(i))) clean += raw.charAt(i);
  }
  if (clean.length() == 11 && clean.startsWith("8")) {
    clean = "7" + clean.substring(1);
  }

  return isPhoneAllowed(clean);
}

// Меню (голосовые подсказки — файлы .amr на SIM800L):
//   0001.amr (ROOT): «Экран 1 нажмите один, экран 2 нажмите два,
//                    перезагрузка интернета и камеры нажмите три»
//   0002.amr (MENU_A / экран 1): «Включить или выключить ПК нажмите один,
//                                 Перезагрузить ПК нажмите два»
//   0003.amr (MENU_B / экран 2): то же для экрана 2
//   0004.amr — подтверждение действия
//   0006.amr — «недоступно» (если SCREEN_COUNT < 2 и нажали 2)
//
// Корневое меню:
//   1 → подменю экрана 1 (реле GPIO25)
//   2 → подменю экрана 2 (реле GPIO26), если SCREEN_COUNT >= 2
//   3 → перезагрузка интернета и камер (реле GPIO32, 60 сек)
// Подменю экрана 1 / 2 (одна кнопка Power на реле):
//   1 → вкл/выкл ПК (короткий импульс Power SW, 0.5 с)
//   2 → перезагрузка ПК (длинный импульс Power SW, 5 с)
//   0 → назад в корневое меню
//   * → сброс звонка
void handleDTMF(char d) {
  if (!callActive) return;
  if (millis() - lastDTMF < DTMF_GUARD) return;
  lastDTMF = millis();

  if (d == '*') {
    sendAT("ATH");
    callActive = false;
    stopAmr();
    return;
  }

  if (menu == ROOT_MENU) {
    // 1 — Экран 1 → подменю (реле GPIO25)
    if (d == '1') { menu = MENU_A; playAmr(2); return; }

#if SCREEN_COUNT >= 2
    // 2 — Экран 2 → подменю (реле GPIO26)
    if (d == '2') { menu = MENU_B; playAmr(3); return; }
#else
    // Экран 2 не настроен — «недоступно», остаёмся в ROOT_MENU
    if (d == '2') { playAmr(6); return; }
#endif

    // 3 — Перезагрузка интернета и камер (реле GPIO32, 60 сек)
    if (d == '3') {
      pulseOutput(2, TIMEOUT_INET_CAM);
      playAmr(4);
      return;
    }
    return;
  }

  // Подменю экрана 1 — реле [0] = GPIO25
  if (menu == MENU_A) {
    // 1 — Вкл/выкл ПК (короткий импульс)
    if (d == '1') { pulseOutput(0, PULSE_PC_SHORT); playAmr(4); return; }
    // 2 — Перезагрузка ПК (длинный импульс Power, длительность из NVS / SMS)
    if (d == '2') { pulseOutput(0, pulsePcLong); playAmr(4); return; }
    // 0 — назад в корневое меню
    if (d == '0') { menu = ROOT_MENU; playAmr(1); }
    return;
  }

#if SCREEN_COUNT >= 2
  // Подменю экрана 2 — реле [1] = GPIO26
  if (menu == MENU_B) {
    // 1 — Вкл/выкл ПК (короткий импульс)
    if (d == '1') { pulseOutput(1, PULSE_PC_SHORT); playAmr(4); return; }
    // 2 — Перезагрузка ПК (длинный импульс Power, длительность из NVS / SMS)
    if (d == '2') { pulseOutput(1, pulsePcLong); playAmr(4); return; }
    // 0 — назад в корневое меню
    if (d == '0') { menu = ROOT_MENU; playAmr(1); }
    return;
  }
#endif
}

void pulseOutput(int index, unsigned long duration) {
  relayOn(index);
  pinState[index]    = true;
  pinTimer[index]    = millis();
  pinDuration[index] = duration;
}

void outputHandler() {
  for (int i = 0; i < RELAY_COUNT; i++) {
    if (!pinState[i]) continue;
    if (millis() - pinTimer[i] > pinDuration[i]) {
      relayOff(i);
      pinState[i] = false;
      pinDuration[i] = 0;
    }
  }
}

void checkTimeout() {
