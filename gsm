  smsBody += "Фаза B: " + String(stablePhaseB ? "ОК (220В)" : "АВАРИЯ (ВЫКЛ)") + "\n";
  smsBody += "Фаза C: " + String(stablePhaseC ? "ОК (220В)" : "АВАРИЯ (ВЫКЛ)");
