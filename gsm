// =====================================================
// SETUP
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(SIM800_RST_PIN, OUTPUT);
  digitalWrite(SIM800_RST_PIN, HIGH);

  pinMode(PHASE_A, INPUT_PULLUP);
  pinMode(PHASE_B, INPUT_PULLUP);
  pinMode(PHASE_C, INPUT_PULLUP);

  for (int i = 0; i < RELAY_COUNT; i++) {
    pinMode(outputPins[i], OUTPUT);
    relayOff(i);
  }

  stablePhaseA = (digitalRead(PHASE_A) == LOW);
  stablePhaseB = (digitalRead(PHASE_B) == LOW);
  stablePhaseC = (digitalRead(PHASE_C) == LOW);
  lastReadA = stablePhaseA;
  lastReadB = stablePhaseB;
  lastReadC = stablePhaseC;

  sim800.begin(9600, SERIAL_8N1, SIM800_RX_PIN, SIM800_TX_PIN);
  delay(1000);

  phonesLoad();
  cfgLoad();

  initSIM();

  // Версия прошивки (FW_VERSION) больше не подставляется в текст SMS —
  // вместо неё buildPhaseStatus() сама добавляет DEVICE_ADDRESS первой
  // строкой. Версия по-прежнему видна в мониторе порта ниже.
  String bootMsg = "СИСТЕМА ЗАПУЩЕНА\r\n" + buildPhaseStatus();
  sendSMSToAll(bootMsg);

  Serial.println(F("PRO FIX v7.7-3RELAY-CFG READY"));
}

// =====================================================
// MAIN LOOP
// =====================================================
void loop() {
  readSIM();          // Единый неблокирующий чтец UART
  if (!otaBusy) runWatchdog();
  outputHandler();
  checkTimeout();
  checkPhases();
  serviceGreeting();  // Неблокирующее проигрывание приветствия

  if (pendingSmsIndex >= 0 && !callActive && !smsBusy && !otaBusy) {
    int idx = pendingSmsIndex;
    pendingSmsIndex = -1;
    processIncomingSms(idx);
  }

  if (otaPending && !callActive && !anyOutputBusy() && !smsBusy && !otaBusy) {
    otaPending = false;
    performOta();
  }

  if (reinitPending && !otaBusy) {
    reinitPending = false;
    initSIM();
  } else if (cfunPending && !otaBusy) {
    cfunPending = false;
    resetSIMNetwork();
  }

  tryFlushPendingSMS();
}

// =====================================================
// РЕЛЕ С УЧЕТОМ ПОЛЯРНОСТИ
